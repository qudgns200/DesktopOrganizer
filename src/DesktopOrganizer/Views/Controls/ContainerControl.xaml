<UserControl x:Class="DesktopOrganizer.Views.Controls.ContainerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DesktopOrganizer.Views.Controls"
             Width="{Binding Width}"
             Height="{Binding Height}"
             IsHitTestVisible="True">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <local:BoolToVisibilityConverter        x:Key="InvBoolToVis" Invert="True"/>
        <local:StringToBrushConverter           x:Key="StringToBrush"/>
        <local:DoubleToThicknessConverter       x:Key="DblToThickness"/>
        <local:DoubleToCornerRadiusConverter    x:Key="DblToCornerRadius"/>
        <local:DoubleToTopCornerRadiusConverter x:Key="DblToTopCornerRadius"/>
        <local:BorderStyleToDashArrayConverter  x:Key="BorderStyleToDash"/>
    </UserControl.Resources>

    <!-- Right-click context menu (F-005 rename, F-006 delete, F-009 style) -->
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="이름 변경"  Command="{Binding BeginRenameCommand}"/>
            <MenuItem Header="스타일 변경" Command="{Binding EditStyleCommand}"/>
            <Separator/>
            <MenuItem Header="삭제" Command="{Binding DeleteCommand}"/>
        </ContextMenu>
    </UserControl.ContextMenu>

    <!-- Root Grid does not clip, so the drop shadow can render beyond the card bounds -->
    <Grid>
        <!--
            Frosted card (F-009). A soft drop shadow lifts the card off any wallpaper.
            The BODY fill stays translucent so the real desktop icons underneath show
            through (비침습 원칙); visual weight lives in the header, border, shadow, accent.
        -->
        <Grid>
            <Grid.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270"
                                  Opacity="0.55" Color="#FF000000"/>
            </Grid.Effect>

            <!-- Background fill layer (F-009: colour + opacity), full rounded rect -->
            <Border Background="{Binding StyleBackgroundColor, Converter={StaticResource StringToBrush}}"
                    Opacity="{Binding StyleBackgroundOpacity}"
                    CornerRadius="{Binding StyleCornerRadius, Converter={StaticResource DblToCornerRadius}}"/>

            <!-- Content layer -->
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Height=Auto so the row collapses when title is hidden -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header bar (F-007 drag handle, F-005 rename, F-009 style + accent) -->
                <Border Grid.Row="0"
                        CornerRadius="{Binding StyleCornerRadius, Converter={StaticResource DblToTopCornerRadius}}"
                        MinHeight="28"
                        Visibility="{Binding StyleShowTitle, Converter={StaticResource BoolToVis}}"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown"
                        MouseMove="OnTitleBarMouseMove"
                        MouseLeftButtonUp="OnTitleBarMouseLeftButtonUp">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#40000000"/>
                            <GradientStop Offset="1" Color="#59000000"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <!-- Centered title + item-count badge (iTop-style header) -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="10,0,10,0"
                                    Visibility="{Binding IsEditing, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{Binding StyleTitleFontColor, Converter={StaticResource StringToBrush}}"
                                       FontSize="{Binding StyleTitleFontSize}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>

                            <!-- Count badge — filled with the container's accent colour -->
                            <Border Margin="7,0,0,0" MinWidth="18" Height="16"
                                    CornerRadius="8" Padding="5,0"
                                    VerticalAlignment="Center"
                                    Background="{Binding StyleAccentColor, Converter={StaticResource StringToBrush}}">
                                <TextBlock Text="{Binding IconCount}"
                                           Foreground="White" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Inline edit mode (kept left-aligned for a natural caret position) -->
                        <TextBox x:Name="NameEditor"
                                 Margin="10,0,10,0"
                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 SelectionBrush="LightBlue"
                                 CaretBrush="White"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 KeyDown="OnNameEditorKeyDown"
                                 LostFocus="OnNameEditorLostFocus"/>

                        <!-- Accent underline separating header from body -->
                        <Border Height="2" VerticalAlignment="Bottom"
                                Background="{Binding StyleAccentColor, Converter={StaticResource StringToBrush}}"/>
                    </Grid>
                </Border>

                <!-- Content area — double-click launches the icon under the cursor -->
                <Border Grid.Row="1" Background="Transparent"
                        MouseLeftButtonDown="OnBodyMouseLeftButtonDown"/>

                <!-- Resize handles overlay — 8 directions (F-008) -->
                <Grid Grid.RowSpan="2">
                    <!-- Corners -->
                    <Border Width="10" Height="10" Background="Transparent"
                            HorizontalAlignment="Left"    VerticalAlignment="Top"
                            Cursor="SizeNWSE" Tag="NW"
                            MouseLeftButtonDown="OnResizeHandleMouseDown"
                            MouseMove="OnResizeHandleMouseMove"
                            MouseLeftButtonUp="OnResizeHandleMouseUp"/>
                    <Border Width="10" Height="10" Background="Transparent"
                            HorizontalAlignment="Right"   VerticalAlignment="Top"
                            Cursor="SizeNESW" Tag="NE"
                            MouseLeftButtonDown="OnResizeHandleMouseDown"
                            MouseMove="OnResizeHandleMouseMove"
                            MouseLeftButtonUp="OnResizeHandleMouseUp"/>
                    <Border Width="10" Height="10" Background="Transparent"
                            HorizontalAlignment="Left"    VerticalAlignment="Bottom"
                            Cursor="SizeNESW" Tag="SW"
                            MouseLeftButtonDown="OnResizeHandleMouseDown"
                            MouseMove="OnResizeHandleMouseMove"
                            MouseLeftButtonUp="OnResizeHandleMouseUp"/>
                    <Border Width="10" Height="10" Background="Transparent"
                            HorizontalAlignment="Right"   VerticalAlignment="Bottom"
                            Cursor="SizeNWSE" Tag="SE"
                            MouseLeftButtonDown="OnResizeHandleMouseDown"
                            MouseMove="OnResizeHandleMouseMove"
                            MouseLeftButtonUp="OnResizeHandleMouseUp"/>
                    <!-- Edges -->
                    <Border Height="6" Background="Transparent"
                            HorizontalAlignment="Stretch" VerticalAlignment="Top"    Margin="10,0,10,0"
                            Cursor="SizeNS" Tag="N"
                            MouseLeftButtonDown="OnResizeHandleMouseDown"
                            MouseMove="OnResizeHandleMouseMove"
                            MouseLeftButtonUp="OnResizeHandleMouseUp"/>
                    <Border Height="6" Background="Transparent"
                            HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="10,0,10,0"
                            Cursor="SizeNS" Tag="S"
                            MouseLeftButtonDown="OnResizeHandleMouseDown"
                            MouseMove="OnResizeHandleMouseMove"
                            MouseLeftButtonUp="OnResizeHandleMouseUp"/>
                    <Border Width="6" Background="Transparent"
                            HorizontalAlignment="Left"    VerticalAlignment="Stretch" Margin="0,10,0,10"
                            Cursor="SizeWE" Tag="W"
                            MouseLeftButtonDown="OnResizeHandleMouseDown"
                            MouseMove="OnResizeHandleMouseMove"
                            MouseLeftButtonUp="OnResizeHandleMouseUp"/>
                    <Border Width="6" Background="Transparent"
                            HorizontalAlignment="Right"   VerticalAlignment="Stretch" Margin="0,10,0,10"
                            Cursor="SizeWE" Tag="E"
                            MouseLeftButtonDown="OnResizeHandleMouseDown"
                            MouseMove="OnResizeHandleMouseMove"
                            MouseLeftButtonUp="OnResizeHandleMouseUp"/>
                </Grid>

                <!-- Crisp rounded border outline on top; supports dashed/dotted (F-009).
                     Hit-test invisible so it never blocks the handles/body beneath. -->
                <Rectangle Grid.RowSpan="2"
                           IsHitTestVisible="False"
                           RadiusX="{Binding StyleCornerRadius}"
                           RadiusY="{Binding StyleCornerRadius}"
                           Stroke="{Binding StyleBorderColor, Converter={StaticResource StringToBrush}}"
                           StrokeThickness="{Binding StyleBorderThickness}"
                           StrokeDashArray="{Binding StyleBorderStyle, Converter={StaticResource BorderStyleToDash}}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
