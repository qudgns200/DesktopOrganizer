<Window x:Class="DesktopOrganizer.Views.Dialogs.LayoutNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Layout 저장"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

    <StackPanel Margin="16">
        <TextBlock Text="저장할 Layout 이름을 입력하세요." Margin="0,0,0,8"/>

        <TextBox x:Name="NameBox"
                 MaxLength="50"
                 Margin="0,0,0,16"
                 KeyDown="OnKeyDown"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="저장" Width="80" Margin="0,0,8,0"
                    IsDefault="True" Click="OnSaveClick"/>
            <Button Content="취소" Width="80"
                    IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </StackPanel>
</Window>
