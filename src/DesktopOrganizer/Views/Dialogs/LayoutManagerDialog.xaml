<Window x:Class="DesktopOrganizer.Views.Dialogs.LayoutManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Layout 관리"
        Width="500" Height="360"
        MinWidth="400" MinHeight="260"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Layout list -->
        <ListBox x:Name="LayoutListBox"
                 Grid.Row="0"
                 ItemsSource="{Binding Layouts}"
                 Margin="0,0,0,10"
                 BorderThickness="1"
                 BorderBrush="#CCCCCC">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Name + meta -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Meta}" Foreground="#888888" FontSize="11"/>
                        </StackPanel>

                        <!-- Restore -->
                        <Button Grid.Column="1"
                                Content="복원"
                                Tag="{Binding Id}"
                                Width="52" Height="26"
                                Margin="6,0,4,0"
                                Click="OnRestoreClick"/>

                        <!-- Delete -->
                        <Button Grid.Column="2"
                                Content="삭제"
                                Tag="{Binding Id}"
                                Width="52" Height="26"
                                Click="OnDeleteClick"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="닫기" Width="80" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
