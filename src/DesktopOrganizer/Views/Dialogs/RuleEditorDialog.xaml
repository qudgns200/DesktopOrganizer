<Window x:Class="DesktopOrganizer.Views.Dialogs.RuleEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DesktopOrganizer.ViewModels"
        xmlns:models="clr-namespace:DesktopOrganizer.Models"
        xmlns:conv="clr-namespace:DesktopOrganizer.Views.Converters"
        Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
        Width="580" MinHeight="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ConditionTypeDisplayConverter  x:Key="CondTypeConv"/>
        <conv:PatternMatchTypeDisplayConverter x:Key="PatternConv"/>
        <conv:FileCategoryDisplayConverter   x:Key="FileCatConv"/>

        <Style TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Rule 이름 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Rule 이름 *" Grid.Column="0"/>
            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <!-- 활성화 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="활성화" Grid.Column="0"/>
            <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"/>
        </Grid>

        <!-- 조건 결합 방식 -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="조건 결합" Grid.Column="0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton Content="AND (모두 만족)" Margin="0,0,16,0"
                             IsChecked="{Binding ConditionCombination,
                                 Converter={StaticResource ResourceKey=BoolToVis},
                                 ConverterParameter={x:Static models:ConditionLogic.And}}"
                             GroupName="Logic" VerticalAlignment="Center"/>
                <RadioButton Content="OR (하나 이상 만족)"
                             GroupName="Logic" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 구분선 -->
        <Separator Grid.Row="3" Margin="0,0,0,8"/>

        <!-- 조건 목록 헤더 -->
        <Grid Grid.Row="4" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Content="조건 목록 *" FontWeight="SemiBold"/>
            <Button Grid.Column="1" Content="+ 조건 추가"
                    Command="{Binding AddConditionCommand}"/>
        </Grid>

        <!-- 조건 항목들 -->
        <ScrollViewer Grid.Row="5" MaxHeight="340" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding Conditions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RuleConditionViewModel}">
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4"
                                Margin="0,0,0,6" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 조건 유형 -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,4">
                                    <Label Content="유형:" Width="40" Padding="0,2"/>
                                    <ComboBox Width="150" SelectedItem="{Binding Type}"
                                              ItemsSource="{Binding ConditionTypes}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource CondTypeConv}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- 삭제 버튼 -->
                                <Button Grid.Row="0" Grid.Column="1"
                                        Content="삭제" Padding="6,2" FontSize="11"
                                        Command="{Binding DataContext.RemoveConditionCommand,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>

                                <!-- 조건 값 — 파일명 패턴 -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                            Orientation="Vertical" Margin="0,2,0,0"
                                            Visibility="{Binding IsFileNamePattern, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="방식:" Width="40" Padding="0,2"/>
                                        <ComboBox Width="120" SelectedItem="{Binding PatternMatchType}"
                                                  ItemsSource="{Binding PatternMatchTypes}" Margin="0,0,8,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource PatternConv}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Label Content="패턴:" Width="40" Padding="0,2"/>
                                        <TextBox Width="200" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <!-- PatternMatchType 힌트 -->
                                    <TextBlock Text="{Binding PatternHint}"
                                               FontSize="10.5" Foreground="#5577BB"
                                               Margin="40,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- 조건 값 — 확장자 -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Margin="0,2,0,0"
                                            Visibility="{Binding IsExtension, Converter={StaticResource BoolToVis}}">
                                    <Label Content="확장자:" Width="50" Padding="0,2"/>
                                    <TextBox Width="360" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="쉼표로 구분 (예: .pdf, .docx)"/>
                                </StackPanel>

                                <!-- 조건 값 — 파일 유형 -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Margin="0,2,0,0"
                                            Visibility="{Binding IsFileCategory, Converter={StaticResource BoolToVis}}">
                                    <Label Content="종류:" Width="40" Padding="0,2"/>
                                    <ComboBox Width="260" SelectedItem="{Binding SelectedCategory}"
                                              ItemsSource="{Binding FileCategories}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource FileCatConv}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- 조건 값 — 날짜 범위 -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Margin="0,2,0,0"
                                            Visibility="{Binding IsDateRange, Converter={StaticResource BoolToVis}}">
                                    <Label Content="시작:" Width="40" Padding="0,2"/>
                                    <TextBox Width="120" Text="{Binding DateFrom, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="yyyy-MM-dd (비워두면 제한 없음)" Margin="0,0,8,0"/>
                                    <Label Content="종료:" Width="40" Padding="0,2"/>
                                    <TextBox Width="120" Text="{Binding DateTo, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="yyyy-MM-dd (비워두면 제한 없음)"/>
                                </StackPanel>

                                <!-- 유형 힌트 (Row 2) -->
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                           Text="{Binding TypeHint}"
                                           FontSize="10.5" Foreground="#777777"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 대상 Container -->
        <Grid Grid.Row="6" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="대상 Container *" Grid.Column="0"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Containers}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding TargetContainerId}"/>
        </Grid>

        <!-- 버튼 -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="저장" Width="80" Margin="0,0,8,0"
                    IsDefault="True" Click="OnSaveClick"/>
            <Button Content="취소" Width="80"
                    IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
